# syntax=docker/dockerfile:1.26.0@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
# The syntax frontend above is an image BuildKit pulls and runs to parse this
# file, so it is digest-pinned like the FROM bases (a floating tag is a
# silent-substitution vector). Re-pin with:
#   docker buildx imagetools inspect docker/dockerfile:1 --format '{{.Manifest.Digest}}'

# ===========================================================================
# SEC-GenerativeSearch — FastAPI backend image
# ===========================================================================
# Multi-stage build:
#   - builder : installs every THIRD-PARTY package (torch + the hash-pinned
#               lock deploy/requirements.txt; pysqlcipher3 compiled against
#               libsqlcipher-dev) into an isolated virtualenv. Never sees src/.
#   - project : builds the application wheel. The only stage that sees src/.
#   - runtime : copies the dependency venv onto a fresh base carrying only the
#               runtime shared libs + gosu, installs the application wheel on
#               top, runs as an unprivileged user.
#
# Layer-cache contract (F26): a source-only edit rebuilds the project stage and
# the final small runtime layers — never the dependency install and never the
# multi-GB venv layer the runtime inherits.
#
# Deployment extras baked in: [encryption,metrics,local-embeddings].
#   - encryption       → pysqlcipher3 (SQLCipher at-rest encryption, B/C).
#   - metrics          → prometheus-client (admin-gated GET /api/metrics).
#   - local-embeddings → torch + sentence-transformers (the default, on-prem
#                        embedder google/embeddinggemma-300m — keeps query +
#                        filing text on own infrastructure.
#
# CUDA torch is the default: the embedder is meant to run on a GPU (on a CPU it
# is too slow for real use), and EMBEDDING_DEVICE=auto only picks CUDA when the
# installed torch was built with it — a CPU-torch image would silently embed on
# the CPU even on a GPU host. cu126 serves the same torch release as the CPU
# index and runs on any driver for CUDA >= 12.6 (Cloud Run L4: driver 580 /
# CUDA 13.0); older CUDA indexes stop early (cu124's newest torch is 2.6.0), so
# check a candidate index's /torch/ listing before switching. For a CPU-only
# host (smaller, faster to build) opt out explicitly:
#   docker build -f deploy/Dockerfile.api \
#     --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu .
#
# Digest-pinned base (supply-chain hardening). Resolve a fresh digest with:
#   docker buildx imagetools inspect python:3.12-slim-bookworm \
#     --format '{{.Manifest.Digest}}'
# Current pin: python 3.12.13-slim-bookworm.
ARG PYTHON_BASE=python:3.12-slim-bookworm@sha256:93ab4b7fa528b25124c97bcc755415e60eb671a86b4dbe0328df2fe2d1c1193d

# --------------------------------------------------------------------------
# Builder stage
# --------------------------------------------------------------------------
FROM ${PYTHON_BASE} AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Build toolchain + SQLCipher headers. pysqlcipher3 (the [encryption] extra)
# compiles a C extension against libsqlcipher-dev; neither survives into the
# runtime stage.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential \
        libsqlcipher-dev \
    && rm -rf /var/lib/apt/lists/*

# Isolated virtualenv — copied wholesale into the runtime stage so no build
# toolchain leaks forward.
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# Torch wheel index. Default = CUDA 12.6 (see the header); override with
# --build-arg for a CPU-only image. torch is the ONE dependency outside the
# hash-pinned lock below: its wheel index is a build-arg, so no single set of
# hashes fits every variant. The lock is compiled against CPU torch with torch
# omitted, which keeps it variant-agnostic: the accelerator payload (nvidia-*,
# triton) arrives only from this step, never from the lock. Keep the
# specifier in lockstep with pyproject.toml's [local-embeddings] extra.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
RUN pip install --upgrade pip \
    && pip install "torch>=2.2" --index-url "${TORCH_INDEX_URL}"

# Every other third-party package comes from the compiled lock (F26), and the
# lock is the ONLY file this stage takes from the build context — so a source
# edit can never bust this layer. --require-hashes: every downloaded artefact
# must match a sha256 recorded in the lock. --no-deps: install exactly the
# pinned set and resolve nothing outside it. pip check then fails the build if
# the lock and the index-resolved torch disagree. Regenerate the lock with the
# command in its header whenever pyproject.toml's dependencies change.
COPY deploy/requirements.txt /tmp/requirements.txt
RUN pip install --require-hashes --no-deps -r /tmp/requirements.txt \
    && pip check \
    && rm /tmp/requirements.txt

# Bake the tiktoken BPE files into the image (F25). RetrievalService builds its
# cl100k_base counter inside the API lifespan, and with an empty cache tiktoken
# downloads it from Azure blob storage — a boot-time egress dependency. The
# cache MUST sit under /opt/venv: that tree is the only thing the runtime stage
# inherits (COPY --from=builder /opt/venv). It lands root-owned, so the
# unprivileged server can read but never rewrite it, and tiktoken re-verifies
# each blob's pinned SHA-256 on every read. Exactly the two encodings the
# codebase can reach are fetched: cl100k_base (retrieval, orchestrator,
# Anthropic/Gemini approximation, fallback for every uncatalogued slug) and
# o200k_base (the catalogued OpenAI models). The runtime ENV below MUST name
# the same path. tiktoken arrives with the lock, so this download is cached
# with the dependency layers rather than repeated on every source edit.
ENV TIKTOKEN_CACHE_DIR=/opt/venv/tiktoken-cache
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base'); tiktoken.get_encoding('o200k_base')"

# --------------------------------------------------------------------------
# Project stage
# --------------------------------------------------------------------------
# Builds the application wheel and nothing else. Independent of the builder, so
# BuildKit runs it in parallel and a source edit touches only this stage plus
# the last runtime layers. --no-deps: /wheels MUST hold our wheel alone — the
# runtime installs everything in it without an index, so a dependency wheel
# here would bypass the lock's hashes.
FROM ${PYTHON_BASE} AS project

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip wheel --no-deps --wheel-dir /wheels .

# --------------------------------------------------------------------------
# Runtime stage
# --------------------------------------------------------------------------
FROM ${PYTHON_BASE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}" \
    TIKTOKEN_CACHE_DIR=/opt/venv/tiktoken-cache \
    HF_HOME=/app/data/hf \
    APP_USER=appuser \
    APP_DATA_DIR=/app/data

# Runtime-only system packages:
#   - libsqlcipher0 : shared lib the compiled pysqlcipher3 extension links.
#   - gosu          : drop from root → appuser in the entrypoint after the
#                     mounted volume has been re-owned (non-root server).
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        libsqlcipher0 \
        gosu \
    && rm -rf /var/lib/apt/lists/*

# Unprivileged service account. The container starts as root only long enough
# to chown the data volume, then the entrypoint execs the server as this user.
RUN useradd --system --create-home --uid 10001 --shell /usr/sbin/nologin appuser

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
# Writable mount points; the entrypoint re-chowns them at boot to cover a
# freshly attached, root-owned host/named volume.
RUN mkdir -p "${APP_DATA_DIR}" "${HF_HOME}" \
    && chown -R appuser:appuser /app

COPY deploy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# The application itself, last and on its own (F26): a source edit changes only
# this small layer while the venv layer above stays byte-identical. --no-index
# + --no-deps: install our wheel from the local path and nothing else — every
# dependency is already in the venv from the hashed lock. pip check fails the
# build if the lock no longer satisfies a dependency pyproject.toml declares.
COPY --from=project /wheels /tmp/wheels
RUN pip install --no-deps --no-index --no-cache-dir --disable-pip-version-check /tmp/wheels/*.whl \
    && pip check --disable-pip-version-check \
    && rm -rf /tmp/wheels

# SQLite + ChromaDB persistence, plus the HF model cache (HF_HOME=/app/data/hf)
# so the gated embedder weights are downloaded once per volume, not once per
# container. Operators MUST attach a durable volume here — task_history is the
# only crash-durable ingest record. Exception: on a FUSE-backed volume (Cloud
# Run gcsfuse) the manifest overrides HF_HOME to container-local disk, so the
# weights are never memory-mapped over FUSE. Keep HF_HOME in lockstep with the
# default in docker-entrypoint.sh.
VOLUME ["/app/data"]
EXPOSE 8000

# Liveness probe against the unauthenticated, deliberately tiny /api/health.
# Uses python only — the slim base ships no curl/wget.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"]

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
# Exactly one worker: TaskManager runs ingest workers in-process and mints
# task IDs in-process, so a second worker produces orphan task-404s.
# --proxy-headers because nginx / GFE terminates TLS and forwards the client
# address upstream.
#
# The trusted-proxy set is DEPLOYMENT-SUPPLIED via $FORWARDED_ALLOW_IPS, never
# baked here, and NEVER "*".  With "*" uvicorn takes the always_trust path and
# reads the LEFTMOST X-Forwarded-For entry — which nginx's
# `$proxy_add_x_forwarded_for` leaves fully client-controlled (it appends the
# real peer to the RIGHT).  Any client could then rotate `scope["client"]` per
# request and defeat every per-IP rate-limit window.  With a bounded set
# uvicorn walks the chain from the right and returns the first *untrusted*
# host — the real client — making the rate-limit key un-spoofable.
# Unset, uvicorn falls back to "127.0.0.1": client addresses collapse onto the
# proxy's own address (per-IP fairness is lost) but nothing is spoofable, so
# the default fails SAFE rather than open.  Compose pins the API network's
# subnet and sets FORWARDED_ALLOW_IPS to exactly that CIDR.
CMD ["uvicorn", "sec_generative_search.api.app:create_app", "--factory", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--proxy-headers"]
